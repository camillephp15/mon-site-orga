  "subjectsData": {
    "maths": [
      {
        "id": "maths-ch1",
        "title": "Algèbre linéaire & Réduction",
        "exosTodo": "• Exercices 3, 5 et 8 de la feuille TD 2\n• DM 2 : Matrices circulantes et diagonalisation",
        "exosHard": "• Endomorphismes cycliques et lemme des noyaux\n• Réduction de Dunford (décomposition N+D)",
        "methods": "• Pour diagonaliser A : calculer P_A(X) = det(A - X I_n), chercher le spectre, vérifier dim ker(A - lambda I_n) = mult(lambda).\n• Théorème de Cayley-Hamilton : chi_u(u) = 0."
      },
      {
        "id": "maths-ch2",
        "title": "Séries numériques & Séries entières",
        "exosTodo": "• Étudier la convergence de sum (-1)^n ln(n)/sqrt(n)\n• Rayon de convergence de sum (n!/n^n) x^n",
        "exosHard": "• Formule de Stirling via intégrales de Wallis\n• Théorème d'Abel angulaire",
        "methods": "• Règle de d'Alembert : si lim |u_{n+1}/u_n| = l < 1, la série converge.\n• CSSA : si (|u_n|) décroît vers 0 avec signe alterné, |R_n| <= |u_{n+1}|."
      },
      {
        "id": "maths-ch3",
        "title": "Intro aux statistiques",
        "exosTodo": "• Calcul des estimateurs sans biais de la moyenne et variance\n• Tests d'hypothèse (Student et Chi-2)",
        "exosHard": "• Loi forte des grands nombres et TCL\n• Intervalle de confiance asymptotique",
        "methods": "• Espérance E(X), Variance V(X) = E(X^2) - E(X)^2.\n• Théorème Central Limite : moyenne centrée réduite converge vers N(0,1)."
      }
    ],
    "physique": [
      {
        "id": "phy-ch1",
        "title": "Résistance des matériaux (RDM)",
        "exosTodo": "• Diagramme des moments fléchissants et efforts tranchants\n• Calcul de la flèche d'une poutre encastrée",
        "methods": "• Équation de Navier-Bernoulli : sigma = M_f * y / I_Gz.\n• Flèche : E I_Gz v''(x) = - M_f(x)."
      },
      {
        "id": "phy-ch2",
        "title": "Mécanique des fluides",
        "exosTodo": "• Écoulement de Poiseuille en conduite cylindrique\n• Théorème de Bernoulli avec pertes de charge",
        "methods": "• Équation de Navier-Stokes pour fluide newtonien incompressible.\n• Nombre de Reynolds : Re = rho * v * D / mu."
      },
      {
        "id": "phy-ch3",
        "title": "Systèmes électroniques",
        "exosTodo": "• Filtres actifs d'ordre 2 (Sallen-Key, Rauch)\n• Diagramme de Bode (gain et phase)",
        "methods": "• Fonction de transfert H(jw) = S / E.\n• Fréquence de coupure à -3dB : |H(w_c)| = H_max / sqrt(2)."
      }
    ],
    "info": [
      {
        "id": "info-ch1",
        "title": "Algorithmique et POO",
        "exosTodo": "• Héritage, polymorphisme et interfaces\n• Implémentation des patrons de conception (Singleton, Factory)",
